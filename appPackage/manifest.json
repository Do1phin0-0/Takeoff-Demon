      { "id": "subcontractor-finder-hvac",       "file": "agents/hvac.json" },
      { "id": "subcontractor-finder-framing",    "file": "agents/framing.json" },
      { "id": "subcontractor-finder-concrete",   "file": "agents/concrete.json" },
      { "id": "subcontractor-finder-roofing",    "file": "agents/roofing.json" }
    ]
